{
  "name": "tomato-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tomato — серверная часть коллективной боталки (Pomodoro + геймификация)",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "start:demo": "node --disable-warning=ExperimentalWarning src/server.js --demo",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-timeout=90000 \"tests/*.test.js\"",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:bots": "node scripts/demo-bots.mjs",
    "cheat-check": "node scripts/cheat-check.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
