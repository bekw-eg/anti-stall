{
  "name": "tomato-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tomato — серверная часть коллективной боталки (Pomodoro + геймификация)",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "start:demo": "TOMATO_DEMO=1 node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/*.test.js\"",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
